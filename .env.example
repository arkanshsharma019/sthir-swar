# Optional AI. The app starts and works without any key.
# With a key, "How I feel" decodes free speech into symptoms and "Speak" answers general questions.
# Set ONE of these (Claude is used if both are set):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

